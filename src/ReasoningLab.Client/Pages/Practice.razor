@page "/practice/{Pathway}"
@implements IDisposable
@inject LabApi Api
<PageTitle>Practice · ReasoningLab</PageTitle>
<div class="page-heading"><div><div class="eyebrow">YOUR NEXT CONNECTION</div><h1>@Title</h1><p>Your shared reasoning skills travel with you.</p></div><a class="text-link" href="/">View progress ↗</a></div>
@if(error is not null){<div class="error" role="alert">@error <button @onclick="Reload">Try again</button></div>}
@if(session is null){<section class="panel"><p>Finding your next challenge…</p></section>}
else
{
    <div class="practice-layout"><div>
        <div class="session-bar"><span><span class="status-dot"></span> @(session.Mode == "practice" ? "Adaptive practice" : "Fixed short diagnostic")</span><span>@session.Answered answered @if(session.Total is not null){<span> / @session.Total</span>}</span>@if(session.Deadline is not null && !session.Completed){<strong aria-label="Time remaining">@TimeRemaining</strong>}</div>
        @if(displayQuestion is not null && (!session.Completed || feedback is not null))
        {<QuestionPanel Question="displayQuestion" Feedback="feedback" Busy="busy" IsDiagnostic="@(session.Mode == "diagnostic")" OnAnswer="Answer" OnContinue="Continue" />}
        else if(session.Completed){<section class="panel completion"><span class="completion-mark">✓</span><h2>A moment to reflect.</h2><p>You answered @session.Result!.Correct of @session.Result.Total questions correctly.</p><p class="muted">@session.Result.Label</p><a class="button primary" href="/">See your progress →</a><button class="button secondary" @onclick="() => Start(false)">Back to practice</button></section>}
        else if(session.Exhausted){<section class="panel completion"><span class="completion-mark">✦</span><h2>You've explored this starter bank.</h2><p>Your progress is saved. Come back when review is due, or try another pathway.</p><a class="button primary" href="/">Explore your progress →</a></section>}
    </div><aside class="practice-aside"><section class="panel"><span class="eyebrow">THE SKILL BEHIND IT</span><h3>Deductive reasoning</h3><p>Work from what you know. Separate what must be true from what could be true.</p>@if(skill is not null){<SkillMeter Level="skill.Level" Correct="skill.Correct" Attempts="skill.Attempts" />}<p class="small muted">Your level is shared across general, LSAT and UCAT practice.</p></section>
        @if(Pathway == "lsat" && session.Mode == "practice"){<section class="panel diagnostic-card"><span class="eyebrow">TRY A DIFFERENT PACE</span><h3>Three minutes.<br />One fixed challenge.</h3><p>3 original questions. A fixed order. Feedback after you finish. No tools.</p><button class="button secondary" disabled="@busy" @onclick="() => Start(true)">Start short diagnostic →</button><p class="small muted">This introductory diagnostic is not a full LSAT mock.</p></section>}
        @if(session.Mode == "practice"){<p class="small muted">Original introductory content. Full exam simulations are not yet available.</p>}
    </aside></div>
}
@code {
    [Parameter] public string Pathway { get; set; } = "general";
    private SessionView? session; private QuestionCard? displayQuestion; private Feedback? feedback;
    private SkillProgress? skill; private bool busy; private string? error; private Timer? timer;
    private TimeSpan offset; private bool disposed; private bool polling;
    private string Title => Pathway switch { "lsat" => "LSAT preparation", "ucat" => "UCAT preparation", _ => "Everyday reasoning" };
    private string TimeRemaining => TimeSpan.FromSeconds(Math.Max(0,(session!.Deadline!.Value-(DateTimeOffset.UtcNow+offset)).TotalSeconds)).ToString(@"mm\:ss");
    protected override async Task OnParametersSetAsync(){timer?.Dispose();session=null;await Start(false);}
    private async Task Start(bool diagnostic)
    {
        if(busy) return;busy=true;error=null;
        try{await Api.Initialize();session=await Api.Post<SessionView>("api/sessions",new StartSession(Pathway,diagnostic?"diagnostic":"practice"));Show();await RefreshSkill();timer?.Dispose();timer=new Timer(async _ => await Tick(),null,1000,1000);}
        catch(Exception ex){error=ex.Message;}finally{busy=false;}
    }
    private void Show(){displayQuestion=session?.Question;feedback=null;if(session is not null)offset=session.ServerNow-DateTimeOffset.UtcNow;}
    private async Task RefreshSkill(){var dashboard=await Api.Get<Dashboard>("api/dashboard");skill=dashboard.Skills.FirstOrDefault();}
    private async Task Answer(int choice)
    {
        if(busy || displayQuestion is null)return;busy=true;error=null;
        try{session=await Api.Post<SessionView>($"api/sessions/{session!.Id}/answers",new SubmitAnswer(displayQuestion.Id,choice));feedback=session.Feedback;if(feedback is null)Show();await RefreshSkill();}
        catch(Exception ex){error=ex.Message;}finally{busy=false;}
    }
    private void Continue()=>Show();
    private async Task Reload(){if(session is null){await Start(false);return;}try{error=null;session=await Api.Get<SessionView>($"api/sessions/{session.Id}");Show();}catch(Exception ex){error=ex.Message;}}
    private async Task Tick()
    {
        if(disposed || polling)return;
        await InvokeAsync(async()=>{if(disposed)return;polling=true;try{if(!busy && session?.Deadline is not null && !session.Completed && session.Deadline <= DateTimeOffset.UtcNow+offset)await Reload();StateHasChanged();}finally{polling=false;}});
    }
    public void Dispose(){disposed=true;timer?.Dispose();}
}
